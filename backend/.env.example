# Backend configuration. Copy to backend/.env for local work, or paste these keys
# into Render's Environment tab in production. Never commit real values.

# --- required ---------------------------------------------------------------

# Exact origin of the frontend, scheme included, no trailing path.
# Local dev:  http://localhost:5173
# Production: https://<your-project>.pages.dev
# "*" is rejected on purpose: this is the only thing standing between the write
# endpoint and any other website.
ALLOWED_ORIGIN=http://localhost:5173

# --- strongly recommended ---------------------------------------------------

# Neon pooled connection string, from the Neon dashboard ("Pooled connection").
# Leave empty to run the API without a database: the map still works, feedback
# submission is disabled and /api/health reports "degraded". Useful for frontend
# work; never leave it empty in production.
DATABASE_URL=

# Bearer token for GET /api/admin/export. Generate a long random value, e.g.
#   openssl rand -hex 32
# Empty disables the export endpoint entirely (it then always answers 401).
ADMIN_TOKEN=

# --- optional ---------------------------------------------------------------

# Port to listen on. Render sets this automatically; 8080 is the default.
PORT=8080

# Which iteration of the map submissions are stamped with. Bump when you cut a
# new iteration so feedback stays attached to the ratings it was given against.
ITERATION=0

# Salt for the sha256 of submitter IPs. Raw IPs are never stored.
# If left empty a random salt is generated at every boot, which means hashes are
# not comparable across restarts — that is the more private default. Set a fixed
# value only if you need to recognise repeat submitters by address.
IP_HASH_SALT=

# Cloudflare Turnstile secret key. When set, every submission must carry a valid
# Turnstile token. Leave empty to run without a CAPTCHA (the honeypot and the
# rate limiter still apply).
TURNSTILE_SECRET=
