# Frontend configuration. Copy to frontend/.env for local work, or set these in
# the Cloudflare Pages project settings. Everything here ends up in the public
# bundle, so never put a secret in this file.

# Base URL of the Go API, no trailing slash.
# Local dev:  http://localhost:8080
# Production: https://<your-service>.onrender.com
# Leave empty to build a map-only site: the grid, the priorities and the agenda
# pages all work, and the feedback form says collection is switched off.
VITE_API_BASE=http://localhost:8080

# Cloudflare Turnstile *site* key (the public half). Only set this if you also
# set TURNSTILE_SECRET on the backend, otherwise the widget renders and the
# server ignores it. Leave empty to run without a CAPTCHA.
VITE_TURNSTILE_SITE_KEY=

# Address shown in the privacy notice for GDPR access/erasure requests.
VITE_CONTACT_EMAIL=
